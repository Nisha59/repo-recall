# GitHub API access (used for fetching issues/comments)
GITHUB_TOKEN=

# Target repository, configurable per RepoRecall's "any repo" goal
GITHUB_REPO=kubernetes/kubernetes
DOCS_REPO_URL=https://github.com/kubernetes/website
DOCS_CONTENT_PATH=content/en/docs
DOCS_PUBLIC_BASE_URL=https://kubernetes.io/docs

# Vector store backend: "lancedb" or "postgres"
VECTOR_BACKEND=lancedb
LANCEDB_PATH=./data/lancedb
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/repo_recall

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=64

# Chunking (sizes in embedding-model tokens; keep max under the model's input limit)
CHUNK_MAX_TOKENS=480
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=40
ISSUE_MAX_COMMENTS=5

# Retrieval: RETRIEVAL_MODE is "vector", "keyword" or "hybrid" (Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=50
# Max chunks from one docs page or issue in a result list (0 = no cap)
RETRIEVAL_MAX_PER_SOURCE=2
RRF_K=60

# Answer generation: LLM_PROVIDER is "ollama" (local) or "openai" (any OpenAI-compatible API).
# LLM_BASE_URL defaults to http://localhost:11434 for ollama, https://api.openai.com/v1 for openai.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT=120
# Prices in USD per million tokens, for the per-query cost estimate (0 for local models)
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
OLLAMA_NUM_CTX=8192

# Evaluation set: candidate issues come from this GitHub search query; eval issues are
# excluded from the search index
EVAL_CANDIDATE_QUERY=label:kind/support
EVAL_SET_PATH=data/eval/eval_set.jsonl
EVAL_MIN_EXAMPLES=150
EVAL_MAX_EXAMPLES=200

# Evaluation run: the LLM judge (same provider/key as LLM_*, its own model and prices)
EVAL_JUDGE_MODEL=gpt-5-mini
EVAL_JUDGE_MAX_TOKENS=4000
EVAL_JUDGE_INPUT_COST_PER_MTOK=0.25
EVAL_JUDGE_OUTPUT_COST_PER_MTOK=2.00
EVAL_RESULTS_DIR=data/eval/results

LOG_LEVEL=INFO
